.venv/
__pycache__/
*.pyc
*.pyo
logs/
dist/
build/
*.db
*.db-shm
*.db-wal
*.pdf

# WiX installer artefacts (generated by build_msi.ps1)
installer/obj/
installer/harvested_*.wxs
installer/*.msi
installer/*.wixpdb
installer/*.log
installer/Installer-avec-log.cmd

#
.VSCodeCounter

# Regression test artefacts (synthetic library regenerated by
# tools/test_env/generate_library.py, logs of failed e2e sessions)
tests/_generated_library/
tests/e2e/.artifacts/

# pytest-cov report (+ the per-process files of the parallel/e2e mode)
.coverage
.coverage.*

# Intermediate coverage checkpoints (base/e2e/combined, cf. CLAUDE.md) — named outside the
# ".coverage." prefix so they are not swallowed by a "coverage combine" with no argument
coverage_base.dat
coverage_e2e.dat
coverage_combined.dat
